# Configuracao do cluster k3s distribuido em 2 PCs.
# Copie este arquivo para .env.distributed e preencha com os valores reais:
#   cp .env.distributed.example .env.distributed
#
# Os scripts em scripts/ leem este arquivo automaticamente.

# IP da LAN do PC-1 (no k3s server, onde Postgres/Kafka/Eureka/Gateway/UI ficam fixos).
# Use o IP visivel na LAN, nao 127.0.0.1.
# Para descobrir: dentro do WSL Ubuntu do PC-1, rode `hostname -I`.
PC1_IP=192.168.1.10

# IP da LAN do PC-2 (no k3s agent).
# Para descobrir: dentro do WSL Ubuntu do PC-2, rode `hostname -I`.
PC2_IP=192.168.1.11

# Usuario SSH no PC-2 (para o scp das imagens). Tipicamente o nome do usuario Linux do WSL.
PC2_SSH_USER=usuario

# Token compartilhado entre server e agent. Qualquer string secreta, mas igual nos dois PCs.
K3S_TOKEN=escolar-demo-token-2026
